{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "budget": "node scripts/js-budget.ts",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/pages.spec.ts tests/e2e/background-contrast.spec.ts",
    "audit": "node scripts/audit-report.ts",
    "lighthouse:summary": "node scripts/lighthouse-summary.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "8.1.3",
    "astro": "7.4.7",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "es-module-lexer": "3.0.4",
    "oxlint": "1.92.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
