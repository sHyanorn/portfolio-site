---
import { getImage, Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '../lib/i18n'
import { shotImage, themeCopies } from '../lib/shots'
import { withBase } from '../lib/paths'
import Text from './Text.astro'

interface Props {
  demo: CollectionEntry<'projects'>['data']['demo']
  lang: Lang
  /** The first-screen demo, or the screenshots after it. */
  part: 'first' | 'rest'
}

const { demo, lang, part } = Astro.props
// AVIF from the build (D013); screenshots also get a full-size copy to open.
const poster =
  'video' in demo
    ? await getImage({ src: demo.poster, format: 'avif' })
    : undefined
const shots =
  'images' in demo
    ? await Promise.all(
        (part === 'first' ? demo.images.slice(0, 1) : demo.images.slice(1)).map(
          async (shot) => ({
            ...shot,
            variants: await Promise.all(
              themeCopies(shot).map(async (v) => ({
                ...v,
                full: await getImage({ src: v.src, format: 'avif' }),
              })),
            ),
          }),
        ),
      )
    : []
---

{'video' in demo
  ? part === 'first' && (
      <figure
        class="video"
        style={`--ratio: ${demo.poster.width} / ${demo.poster.height}`}
      >
        <video
          controls
          muted
          loop
          playsinline
          preload="none"
          poster={poster!.src}
          width={demo.poster.width}
          height={demo.poster.height}
        >
          <source src={withBase(demo.video)} type="video/mp4" />
        </video>
        <figcaption>
          <Text value={demo.caption[lang]} />
        </figcaption>
      </figure>
    )
  : shots.length > 0 && (
      <div class={`shots ${part}`}>
        {shots.map((shot, i) => (
          <figure style={`--ratio: ${shot.src.width} / ${shot.src.height}`}>
            {shot.variants.map((v) => (
              <a href={v.full.src} class={v.theme}>
                <Image
                  {...shotImage(v.src, part)}
                  alt={shot.alt[lang]}
                  loading={
                    part === 'first' && i === 0 && !shot.dark ? 'eager' : 'lazy'
                  }
                />
              </a>
            ))}
            <figcaption>
              <Text value={shot.caption[lang]} />
            </figcaption>
          </figure>
        ))}
      </div>
    )}

<style>
  /* The first video or screenshot is no taller than the first screen leaves
     below what sits above it, `--demo-reserve`: the header and a page intro
     of up to four lines of summary, plus a line to spare, when it is stacked
     under the intro. The width follows the aspect ratio. */
  .first figure,
  .video {
    width: min(
      100%,
      max(16rem, 100svh - var(--demo-reserve, 30rem)) * var(--ratio)
    );
    margin-inline: auto;
  }

  /* Later screenshots are read after scrolling: a grid on a wide screen, and
     on a narrow one each fits one screen with its caption. */
  .rest {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .rest figure {
    width: min(100%, max(16rem, 100svh - 8rem) * var(--ratio));
    margin-inline: auto;
  }

  video,
  img {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-surface);
  }

  .shots {
    display: grid;
    gap: var(--space-5);
  }

  /* A block link, so its focus ring goes round the screenshot. */
  .shots a {
    display: block;
    border-radius: var(--radius-3);
  }

  /* A screenshot with a dark copy shows the one that matches the theme, and
     each links to its own full-size copy. Both copies load lazily, so the
     hidden one never loads; DemoPreload starts the first visible one early. */
  @media (prefers-color-scheme: dark) {
    .shots .light {
      display: none;
    }
  }

  @media not (prefers-color-scheme: dark) {
    .shots .dark {
      display: none;
    }
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
