---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { LANG_TAG, otherLang, pagePath, t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
  /** False on a page with no counterpart in the other language. */
  alternates: boolean
}

const { lang, alternates } = Astro.props
const other = otherLang(lang)
const path = pagePath(Astro.url.pathname)
const home = getRelativeLocaleUrl(lang)
---

<header class="header">
  <nav class="nav bleed">
    <a
      class="name"
      href={home}
      aria-current={path === '' && alternates ? 'page' : undefined}
    >
      Aaron Yang
    </a>
    <ul class="links">
      <li>
        <a
          href={`${home}#projects`}
          aria-current={path.startsWith('projects/') ? 'true' : undefined}
        >
          {t(lang, 'projects')}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(lang, 'articles/')}
          aria-current={
            path === 'articles/'
              ? 'page'
              : path.startsWith('articles/')
                ? 'true'
                : undefined
          }
        >
          {t(lang, 'articles')}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(lang, 'about/')}
          aria-current={path === 'about/' ? 'page' : undefined}
        >
          {t(lang, 'about')}
        </a>
      </li>
      {alternates && (
        <li>
          <a
            href={getRelativeLocaleUrl(other, path)}
            hreflang={LANG_TAG[other]}
            lang={LANG_TAG[other]}
          >
            {t(lang, 'language')}
          </a>
        </li>
      )}
    </ul>
  </nav>
</header>

<style>
  /* The header stays at the top of the viewport (D020). Its background is
     the page colour at 90%, which keeps the links at 4.5:1 whatever scrolls
     under it, blurred where the browser can; without the blur it is opaque. */
  .header {
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-line) 50%, transparent);
    background: var(--color-bg);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: color-mix(in srgb, var(--color-bg) 90%, transparent);
      backdrop-filter: blur(12px);
    }
  }

  /* At the top of a page the header has no background and no line. Both
     come in over the 3rem a page scrolls before its content reaches the
     header; a page too short to scroll never shows them. Longhands, as for
     `.reveal` (D014). */
  @keyframes header-in {
    to {
      border-bottom-color: var(--color-line);
      background-color: color-mix(in srgb, var(--color-bg) 90%, transparent);
      backdrop-filter: blur(12px);
    }
  }

  @supports (animation-timeline: scroll()) {
    .header {
      border-bottom-color: transparent;
      background-color: transparent;
      backdrop-filter: blur(0);
      animation-name: header-in;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
      animation-range: 0 var(--space-5);
    }
  }

  @media (forced-colors: active) {
    .header {
      background: Canvas;
      backdrop-filter: none;
      animation: none;
    }
  }

  @media print {
    .header {
      position: static;
    }
  }

  /* One row; below 22.5rem the links take a second row, and
     `--header-height` follows. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    min-height: calc(var(--header-height) - 1px);
    padding-block: var(--space-2);
  }

  .name {
    font-weight: 600;
    text-decoration: none;
  }

  .name,
  .links a {
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .links a:hover,
  .links a[aria-current] {
    color: var(--color-text);
  }

  /* On a phone the links are smaller and closer, so that one row holds
     them from 22.5rem up. */
  @media (max-width: 29.99rem) {
    .nav {
      column-gap: var(--space-2);
    }

    .links {
      gap: var(--space-2);
      font-size: var(--step--1);
    }
  }

  @media (max-width: 22.49rem) {
    .links {
      flex-basis: 100%;
    }
  }
</style>
