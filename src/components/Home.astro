---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'
import ProjectCard from './ProjectCard.astro'

const lang = toLang(Astro.currentLocale)
const projects = await getCollection('projects')
---

<Base title="Aaron Yang" description={t(lang, 'description')}>
  <div class="backdrop" aria-hidden="true">
    <canvas></canvas>
  </div>

  <section class="intro">
    <h1 class="rise">Aaron Yang</h1>
  </section>

  <section
    id="projects"
    class="rise"
    style="--rise: 1"
    aria-labelledby="projects-title"
  >
    <h2 id="projects-title">{t(lang, 'projects')}</h2>
    <div class="list">
      {projects.map((project) => (
        <ProjectCard {project} {lang} />
      ))}
    </div>
  </section>
</Base>

<script>
  import { mountBackground } from '../gl/background'

  const canvas = document.querySelector<HTMLCanvasElement>('.backdrop canvas')
  if (canvas) mountBackground(canvas)
</script>

<style>
  /* The background field (D015): one screen high at the top of the page,
     behind the header and the introduction, fading out at the bottom. The
     gradient shows until the canvas draws its first frame, and stays when
     WebGL2 is unavailable. */
  .backdrop {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 100svh;
    background: linear-gradient(var(--color-accent-subtle), transparent);
    mask-image: linear-gradient(#000 50%, transparent);
    pointer-events: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    contain: strict;
    opacity: 0;
  }

  canvas.ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    canvas {
      transition: opacity 600ms var(--ease-out);
    }
  }

  .intro {
    padding-block: var(--space-6) var(--space-7);
  }

  h1 {
    font-size: var(--step-5);
    line-height: 1.1;
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }
</style>
