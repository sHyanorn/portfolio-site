---
// A screenshot enlarged on its page (D013): a click on one opens its
// full-size copy in a modal dialog instead of leaving for the file. The
// close button, a click beside the picture, Escape and the browser's Back
// all close it. Without scripts the screenshot stays a link to the file.
import { t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<dialog class="zoom">
  <button type="button" aria-label={t(lang, 'close')}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path d="M3 3L13 13M13 3L3 13"></path>
    </svg>
  </button>
  <div class="frame">
    <img alt="" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.zoom')
  if (dialog) {
    const picture = dialog.querySelector('img')!

    document.addEventListener('click', (event) => {
      const link =
        event.target instanceof Element &&
        event.target.closest<HTMLAnchorElement>('.shots a')
      // A click that asks for a new tab or a download is the browser's.
      if (
        !link ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      event.preventDefault()
      picture.src = link.href
      dialog.ariaLabel = link.querySelector('img')?.alt ?? ''
      dialog.classList.remove('enlarged')
      dialog.showModal()
      // An entry of its own, so that Back closes the dialog and stays here.
      history.pushState({ zoom: true }, '')
    })

    // The picture switches between fitting the screen and twice the
    // screen's width, up to its own; anything else in the dialog closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target !== picture) return dialog.close()
      dialog.style.setProperty('--natural', `${picture.naturalWidth}px`)
      dialog.classList.toggle('enlarged')
    })

    // Closed by the button, a click or Escape: take the entry back out.
    dialog.addEventListener('close', () => {
      if (history.state?.zoom) history.back()
    })

    // Back closes the dialog; Forward does not return to a closed one.
    addEventListener('popstate', () => {
      if (dialog.open) dialog.close()
      else if (history.state?.zoom) history.back()
    })
  }
</script>

<style>
  /* The whole screen, over the page, scrolling by itself when the picture is
     enlarged. One pixel of overflow keeps a wheel or a swipe from reaching
     the page under it. */
  .zoom {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .zoom::backdrop {
    background: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .zoom[open] {
      animation: appear var(--duration-fast) var(--ease-out);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  .frame {
    display: flex;
    box-sizing: border-box;
    min-width: 100%;
    width: max-content;
    min-height: calc(100% + 1px);
    padding: var(--space-3);
  }

  /* Auto margins centre the picture and, unlike centring by alignment, let
     an enlarged one scroll from its first pixel. */
  img {
    max-width: calc(100vw - 2 * var(--space-3));
    max-height: calc(100dvh - 2 * var(--space-3));
    margin: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-surface);
    cursor: zoom-in;
  }

  .enlarged img {
    width: min(200vw, var(--natural));
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  /* Fixed in the corner, over the picture, and 44 px for a thumb. */
  button {
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  button:hover {
    background: var(--color-bg-subtle);
  }

  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
</style>
