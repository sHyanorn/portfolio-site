---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { ImageMetadata } from 'astro'
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '../lib/i18n'
import { themeCopies } from '../lib/shots'
import Tags from './Tags.astro'
import Text from './Text.astro'

interface Props {
  project: CollectionEntry<'projects'>
  lang: Lang
  /** The first project: wider, with the picture beside the text. */
  featured?: boolean
}

const { project, lang, featured = false } = Astro.props
const p = project.data
// The demo poster or first screenshot, and its dark copy if it has one. The
// title names the project, so the picture is decorative.
const first: { src: ImageMetadata; dark?: ImageMetadata } =
  'video' in p.demo ? { src: p.demo.poster } : p.demo.images[0]!
const thumbs = themeCopies(first)
---

<article class:list={['card', { featured }]}>
  <div class="thumb">
    {thumbs.map((v) => (
      <Image
        src={v.src}
        class={v.theme}
        alt=""
        format="avif"
        widths={[360, 720, 1080].filter((w) => w <= v.src.width)}
        sizes={
          featured
            ? '(min-width: 64rem) 760px, 100vw'
            : '(min-width: 48rem) 580px, 100vw'
        }
        loading="lazy"
      />
    ))}
  </div>
  <div class="text">
    <h3>
      <a href={getRelativeLocaleUrl(lang, `projects/${project.id}/`)}>
        {p.title}
      </a>
    </h3>
    <p>
      <Text value={p.summary[lang]} />
    </p>
    <div class="tags">
      <Tags tags={p.tags.map((tag) => tag[lang])} />
    </div>
  </div>
</article>

<style>
  /* The title link covers the whole card (Inclusive Components, "Cards"). */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-bg);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  /* The whole picture, framed on the card's surface: a crop could cut the
     part of a chart or table that tells what it shows. The frame clips the
     picture to the card's corners, so the card itself need not clip and the
     focus ring outside it shows. */
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-3) - 1px) calc(var(--radius-3) - 1px) 0 0;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .thumb img {
    position: absolute;
    inset: var(--space-3);
    width: auto;
    height: auto;
    max-width: calc(100% - 2 * var(--space-3));
    max-height: calc(100% - 2 * var(--space-3));
    margin: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-2);
    transition: scale var(--duration) var(--ease-out);
  }

  /* The first project's picture fills its frame from the top, where an
     interface has its title and controls. */
  .featured .thumb img {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    border: 0;
    border-radius: 0;
    object-fit: cover;
    object-position: top left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover .thumb img {
      scale: 1.02;
    }
  }

  @media (prefers-color-scheme: dark) {
    .thumb .light {
      display: none;
    }
  }

  @media not (prefers-color-scheme: dark) {
    .thumb .dark {
      display: none;
    }
  }

  .text {
    padding: var(--space-3);
  }

  h3 {
    font-size: var(--step-1);
  }

  a {
    text-decoration: none;
  }

  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-3);
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  p {
    max-width: var(--width-prose);
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .tags {
    margin-top: var(--space-2);
  }

  /* The first project takes the full row, its picture beside the text. */
  @media (min-width: 64rem) {
    .featured {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    /* The picture fills the row the text sets, at least 22rem tall. */
    .featured .thumb {
      position: relative;
      order: 2;
      aspect-ratio: auto;
      min-height: 22rem;
      border-radius: 0 calc(var(--radius-3) - 1px) calc(var(--radius-3) - 1px) 0;
      border-bottom: 0;
      border-left: 1px solid var(--color-line);
    }

    .featured .text {
      align-self: center;
      padding: var(--space-5);
    }

    .featured h3 {
      font-size: var(--step-3);
    }

    .featured p {
      font-size: var(--step-1);
      line-height: 1.5;
    }
  }
</style>
