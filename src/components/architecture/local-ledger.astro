---
// Architecture of local-ledger, drawn by hand in two variants: a wide one drawn
// at 720 px and scaled to fit containers from 664 px up, where its smallest
// text is still above 11 px, and a narrow one drawn at 358 px for narrower
// ones.
interface Props {
  labels: Record<string, string>
  /** Prefix for the arrowhead marker ids, unique on the page. */
  id: string
}

const KEYS = [
  'page',
  'ui',
  'preload',
  'api',
  'files',
  'plain',
  'main',
  'ipc',
  'checks',
  'vault',
  'unseal',
  'data',
  'rules',
  'sealed',
  'encrypted',
  'backup',
  'ipcEdge',
  'importEdge',
  'exportEdge',
] as const

const { labels, id } = Astro.props
const missing = KEYS.filter((key) => !labels[key])
if (missing.length > 0)
  throw new Error(
    `LocalLedger: missing label${missing.length > 1 ? 's' : ''} ${missing.join(', ')}`,
  )
const t = labels as Record<(typeof KEYS)[number], string>

// A box over whole pixels x..x+w, y..y+h, with its 1 px stroke inside.
const box = (x: number, y: number, w: number, h: number) => ({
  x: x + 0.5,
  y: y + 0.5,
  width: w - 1,
  height: h - 1,
})

// A cylinder over x..x+w, y..y+h: the body, then the top face drawn over it.
const cylinder = (x: number, y: number, w: number, h: number, ry = 6) => {
  const l = x + 0.5
  const r = x + w - 0.5
  const top = y + 0.5 + ry
  const bottom = y + h - 0.5 - ry
  const rx = (r - l) / 2
  return {
    body: `M${l} ${top}A${rx} ${ry} 0 0 0 ${r} ${top}V${bottom}A${rx} ${ry} 0 0 1 ${l} ${bottom}Z`,
    face: { cx: l + rx, cy: top, rx, ry },
  }
}

// Marker ids are per instance and per variant: a hidden SVG's markers do not render.
const head = { h: `${id}-head-h`, v: `${id}-head-v` }
const keyH = cylinder(16, 344, 208, 64)
const dbH = cylinder(256, 344, 208, 64)
const backupH = cylinder(496, 344, 208, 64)
const keyV = cylinder(8, 416, 163, 64)
const backupV = cylinder(187, 416, 123, 64)
const dbV = cylinder(8, 512, 163, 64)
// Text goes in through set:text, so formatting adds no spaces that would
// shift centred labels.
---

<div class="diagram">
  <svg
    class="wide"
    width="720"
    height="408"
    viewBox="0 0 720 408"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.h}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(16, 0, 208, 80)} rx="7.5" class="box core"></rect>
    <text x="120" y="26" class="label" set:text={t.page} />
    <text x="120" y="45" class="edge middle" set:text={t.ui} />
    <text x="120" y="63" class="path" set:text="src/renderer" />
    <path class="line" d="M224 40.5H256" marker-end={`url(#${head.h})`}></path>
    <rect {...box(256, 0, 208, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="26" class="label" set:text={t.preload} />
    <text x="360" y="45" class="edge middle" set:text={t.api} />
    <text x="360" y="63" class="path" set:text="src/preload" />
    <rect {...box(496, 0, 208, 80)} rx="7.5" class="box plain"></rect>
    <text x="600" y="36" class="label" set:text={t.files} />
    <text x="600" y="55" class="edge middle" set:text={t.plain} />

    <rect x="0" y="128" width="720" height="176" rx="12" class="region"></rect>
    <text x="16" y="152" class="region-label" set:text={t.main} />
    <path class="line" d="M360.5 80V176" marker-end={`url(#${head.h})`}></path>
    <text x="368" y="108" class="edge" set:text={t.ipcEdge} />
    <path class="line" d="M560.5 80V176" marker-end={`url(#${head.h})`}></path>
    <text x="552" y="108" class="edge end" set:text={t.importEdge} />
    <path class="line" d="M640.5 176V80" marker-end={`url(#${head.h})`}></path>
    <text x="648" y="108" class="edge" set:text={t.exportEdge} />

    <rect {...box(16, 176, 208, 80)} rx="7.5" class="box"></rect>
    <text x="120" y="202" class="label" set:text={t.vault} />
    <text x="120" y="221" class="edge middle" set:text={t.unseal} />
    <text x="120" y="239" class="path" set:text="src/main/vault" />
    <path class="line" d="M256 216.5H224" marker-end={`url(#${head.h})`}></path>
    <rect {...box(256, 176, 208, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="202" class="label" set:text={t.ipc} />
    <text x="360" y="221" class="edge middle" set:text={t.checks} />
    <text x="360" y="239" class="path" set:text="src/main" />
    <path class="line" d="M464 216.5H496" marker-end={`url(#${head.h})`}></path>
    <rect {...box(496, 176, 208, 80)} rx="7.5" class="box"></rect>
    <text x="600" y="202" class="label" set:text={t.data} />
    <text x="600" y="221" class="edge middle" set:text={t.rules} />
    <text x="600" y="239" class="path" set:text="src/main/import" />

    <path class="line" d="M120.5 256V344" marker-end={`url(#${head.h})`}></path>
    <path class="line" d="M360.5 256V344" marker-end={`url(#${head.h})`}></path>
    <path class="line" d="M600.5 256V344" marker-end={`url(#${head.h})`}></path>

    <path d={keyH.body} class="box"></path>
    <ellipse {...keyH.face} class="box"></ellipse>
    <text x="120" y="380" class="label" set:text="vault.json" />
    <text x="120" y="398" class="edge middle" set:text={t.sealed} />
    <path d={dbH.body} class="box"></path>
    <ellipse {...dbH.face} class="box"></ellipse>
    <text x="360" y="380" class="label" set:text={'ledger-<n>.db'} />
    <text x="360" y="398" class="edge middle" set:text={t.encrypted} />
    <path d={backupH.body} class="box"></path>
    <ellipse {...backupH.face} class="box"></ellipse>
    <text x="600" y="380" class="label" set:text=".llbackup" />
    <text x="600" y="398" class="edge middle" set:text={t.backup} />
  </svg>

  <svg
    class="narrow"
    width="358"
    height="592"
    viewBox="0 0 358 592"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.v}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(0, 0, 167, 80)} rx="7.5" class="box core"></rect>
    <text x="83.5" y="26" class="label" set:text={t.page} />
    <text x="83.5" y="45" class="edge middle" set:text={t.ui} />
    <text x="83.5" y="63" class="path" set:text="src/renderer" />
    <path class="line" d="M167 40.5H191" marker-end={`url(#${head.v})`}></path>
    <rect {...box(191, 0, 167, 80)} rx="7.5" class="box"></rect>
    <text x="274.5" y="26" class="label" set:text={t.preload} />
    <text x="274.5" y="45" class="edge middle" set:text={t.api} />
    <text x="274.5" y="63" class="path" set:text="src/preload" />

    <rect x="0" y="128" width="358" height="256" rx="12" class="region"></rect>
    <text x="12" y="152" class="region-label" set:text={t.main} />
    <path class="line" d="M274.5 80V168" marker-end={`url(#${head.v})`}></path>
    <text x="282" y="112" class="edge" set:text={t.ipcEdge} />

    <rect {...box(8, 168, 342, 80)} rx="7.5" class="box"></rect>
    <text x="179" y="194" class="label" set:text={t.ipc} />
    <text x="179" y="213" class="edge middle" set:text={t.checks} />
    <text x="179" y="231" class="path" set:text="src/main" />
    <path class="line" d="M89.5 248V288" marker-end={`url(#${head.v})`}></path>
    <path class="line" d="M268.5 248V288" marker-end={`url(#${head.v})`}></path>
    <rect {...box(8, 288, 163, 80)} rx="7.5" class="box"></rect>
    <text x="89.5" y="314" class="label" set:text={t.vault} />
    <text x="89.5" y="333" class="edge middle" set:text={t.unseal} />
    <text x="89.5" y="351" class="path" set:text="src/main/vault" />
    <rect {...box(187, 288, 163, 80)} rx="7.5" class="box"></rect>
    <text x="268.5" y="314" class="label" set:text={t.data} />
    <text x="268.5" y="333" class="edge middle" set:text={t.rules} />
    <text x="268.5" y="351" class="path" set:text="src/main/import" />

    <path class="line" d="M89.5 368V416" marker-end={`url(#${head.v})`}></path>
    <path class="line" d="M248.5 368V416" marker-end={`url(#${head.v})`}></path>
    <path d={keyV.body} class="box"></path>
    <ellipse {...keyV.face} class="box"></ellipse>
    <text x="89.5" y="452" class="label" set:text="vault.json" />
    <text x="89.5" y="470" class="edge middle" set:text={t.sealed} />
    <path d={backupV.body} class="box"></path>
    <ellipse {...backupV.face} class="box"></ellipse>
    <text x="248.5" y="452" class="label" set:text=".llbackup" />
    <text x="248.5" y="470" class="edge middle" set:text={t.backup} />
    <path
      class="line"
      d="M179.5 248V544H171"
      marker-end={`url(#${head.v})`}
    ></path>
    <path d={dbV.body} class="box"></path>
    <ellipse {...dbV.face} class="box"></ellipse>
    <text x="89.5" y="548" class="label" set:text={'ledger-<n>.db'} />
    <text x="89.5" y="566" class="edge middle" set:text={t.encrypted} />

    <path class="line" d="M326.5 368V512" marker-end={`url(#${head.v})`}></path>
    <path class="line" d="M342.5 512V368" marker-end={`url(#${head.v})`}></path>
    <rect {...box(187, 512, 171, 80)} rx="7.5" class="box plain"></rect>
    <text x="272.5" y="548" class="label" set:text={t.files} />
    <text x="272.5" y="567" class="edge middle" set:text={t.plain} />
  </svg>
</div>

<style>
  .diagram {
    container-type: inline-size;
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    font-family: inherit;
  }

  .wide {
    display: none;
  }

  @container (min-width: 664px) {
    .wide {
      display: block;
      width: 100%;
    }

    .narrow {
      display: none;
    }
  }

  .region {
    fill: var(--color-surface);
  }

  .box {
    fill: var(--color-bg-subtle);
    stroke: var(--color-border-strong);
  }

  /* The one use of the accent: the page, the only part a user touches, kept
     in Chromium's sandbox with no Node.js. */
  .core {
    fill: var(--color-accent-subtle);
    stroke: var(--color-accent-line);
  }

  .line {
    fill: none;
    stroke: var(--color-border-strong);
  }

  /* Files outside the vault are plaintext. */
  .plain {
    stroke-dasharray: 4 4;
  }

  .head {
    fill: var(--color-text-muted);
  }

  /* Box labels and paths are centred on their x; edge labels start at it
     unless marked .middle or .end. */
  .label,
  .path,
  .middle {
    text-anchor: middle;
  }

  .end {
    text-anchor: end;
  }

  .label {
    fill: var(--color-text);
    font-size: 14px;
    font-weight: 500;
  }

  .path {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .edge {
    fill: var(--color-text-muted);
    font-size: 12px;
  }

  .region-label {
    fill: var(--color-text-muted);
    font-size: 13px;
    font-weight: 500;
  }
</style>
