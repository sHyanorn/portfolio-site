---
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'

const lang = toLang(Astro.currentLocale)
// The year range stays on one line, without invisible characters in the
// text. The parts form one expression, as line breaks between them would
// render as spaces, which show in Chinese.
const YEARS = '2024–2027'
const d = t(lang, 'degree').split(YEARS)
if (d.length !== 2) throw new Error(`degree must name ${YEARS} once`)
---

<Base
  title={`${t(lang, 'about')} · Aaron Yang`}
  description={t(lang, 'aboutDescription')}
>
  <h1 class="rise">{t(lang, 'about')}</h1>

  <section class="row rise" style="--rise: 1" aria-labelledby="education">
    <h2 id="education">{t(lang, 'education')}</h2>
    <div>
      <p class="school">{t(lang, 'school')}</p>
      <p class="meta">{[d[0], <span class="years">{YEARS}</span>, d[1]]}</p>
    </div>
  </section>

  <section class="row rise" style="--rise: 2" aria-labelledby="direction">
    <h2 id="direction">{t(lang, 'direction')}</h2>
    <p>{t(lang, 'directionBody')}</p>
  </section>
</Base>

<style>
  h1 {
    padding-top: var(--space-4);
    font-size: var(--step-5);
    line-height: 1.1;
  }

  section {
    margin-top: var(--space-6);
  }

  section p {
    max-width: var(--width-prose);
  }

  /* A wide screen puts each heading beside its text, as on project pages. */
  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-line);
    }

    .row + .row {
      margin-top: var(--space-5);
    }

    .row h2 {
      margin: 0;
      font-size: var(--step-2);
    }
  }

  h2 {
    margin-bottom: var(--space-2);
    font-size: var(--step-2);
  }

  .school {
    font-weight: 500;
  }

  .meta {
    color: var(--color-text-muted);
  }

  .years {
    white-space: nowrap;
  }
</style>
