---
// Architecture of backtest-lab, drawn by hand in two variants: a wide one drawn
// at 720 px, the page column, for containers that wide, and a narrow one drawn
// at 358 px for narrower ones, both shown at their drawn size.
interface Props {
  labels: Record<string, string>
  /** Prefix for the arrowhead marker ids, unique on the page. */
  id: string
}

const KEYS = [
  'workflow',
  'actions',
  'update',
  'fetch',
  'store',
  'engine',
  'fills',
  'validation',
  'checks',
  'results',
  'frozen',
  'dashboard',
  'pages',
  'api',
  'local',
  'returns',
  'reports',
  'reads',
  'sweep',
] as const

const { labels, id } = Astro.props
const missing = KEYS.filter((key) => !labels[key])
if (missing.length > 0)
  throw new Error(
    `BacktestLab: missing label${missing.length > 1 ? 's' : ''} ${missing.join(', ')}`,
  )
const t = labels as Record<(typeof KEYS)[number], string>

// A box over whole pixels x..x+w, y..y+h, with its 1 px stroke inside.
const box = (x: number, y: number, w: number, h: number) => ({
  x: x + 0.5,
  y: y + 0.5,
  width: w - 1,
  height: h - 1,
})

// A cylinder over x..x+w, y..y+h: the body, then the top face drawn over it.
const cylinder = (x: number, y: number, w: number, h: number, ry = 6) => {
  const l = x + 0.5
  const r = x + w - 0.5
  const top = y + 0.5 + ry
  const bottom = y + h - 0.5 - ry
  const rx = (r - l) / 2
  return {
    body: `M${l} ${top}A${rx} ${ry} 0 0 0 ${r} ${top}V${bottom}A${rx} ${ry} 0 0 1 ${l} ${bottom}Z`,
    face: { cx: l + rx, cy: top, rx, ry },
  }
}

// Marker ids are per instance and per variant: a hidden SVG's markers do not render.
const head = { h: `${id}-head-h`, v: `${id}-head-v` }
const storeH = cylinder(528, 0, 192, 80)
const storeV = cylinder(0, 224, 214, 80)
// Text goes in through set:text, so formatting adds no spaces that would
// shift centred labels. Data flows left to right along the top row, back
// along the middle row, and down to the dashboard.
---

<div class="diagram">
  <svg
    class="wide"
    width="720"
    height="400"
    viewBox="0 0 720 400"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.h}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(0, 0, 192, 80)} rx="7.5" class="box"></rect>
    <text x="96" y="26" class="label" set:text={t.workflow} />
    <text x="96" y="45" class="edge middle" set:text={t.actions} />
    <text x="96" y="63" class="path" set:text="data.yml" />
    <path class="line" d="M192 40.5H264" marker-end={`url(#${head.h})`}></path>
    <rect {...box(264, 0, 192, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="26" class="label" set:text={t.update} />
    <text x="360" y="45" class="edge middle" set:text={t.fetch} />
    <text x="360" y="63" class="path" set:text="backtest_lab/data" />
    <path class="line" d="M456 40.5H528" marker-end={`url(#${head.h})`}></path>
    <path d={storeH.body} class="box"></path>
    <ellipse {...storeH.face} class="box"></ellipse>
    <text x="624" y="42" class="label" set:text={t.store} />
    <text x="624" y="60" class="path" set:text="data/" />

    <path class="line" d="M624.5 80V160" marker-end={`url(#${head.h})`}></path>

    <rect {...box(528, 160, 192, 80)} rx="7.5" class="box"></rect>
    <text x="624" y="186" class="label" set:text={t.engine} />
    <text x="624" y="205" class="edge middle" set:text={t.fills} />
    <text x="624" y="223" class="path" set:text="backtest_lab/engine" />
    <path class="line" d="M528 200.5H456" marker-end={`url(#${head.h})`}></path>
    <text x="492" y="192" class="edge middle" set:text={t.returns} />
    <rect {...box(264, 160, 192, 80)} rx="7.5" class="box core"></rect>
    <text x="360" y="186" class="label" set:text={t.validation} />
    <text x="360" y="205" class="edge middle" set:text={t.checks} />
    <text x="360" y="223" class="path" set:text="backtest_lab/validation" />
    <path class="line" d="M264 200.5H192" marker-end={`url(#${head.h})`}></path>
    <text x="228" y="192" class="edge middle" set:text={t.reports} />
    <rect {...box(0, 160, 192, 80)} rx="7.5" class="box"></rect>
    <text x="96" y="186" class="label" set:text={t.results} />
    <text x="96" y="205" class="edge middle" set:text={t.frozen} />
    <text x="96" y="223" class="path" set:text="results/demo" />

    <path class="line" d="M96.5 240V320" marker-end={`url(#${head.h})`}></path>
    <text x="104" y="284" class="edge" set:text={t.reads} />

    <rect {...box(0, 320, 192, 80)} rx="7.5" class="box"></rect>
    <text x="96" y="346" class="label" set:text={t.dashboard} />
    <text x="96" y="365" class="edge middle" set:text={t.pages} />
    <text x="96" y="383" class="path" set:text="web" />
    <path class="link" d="M192 360.5H528" marker-end={`url(#${head.h})`}></path>
    <text x="360" y="352" class="edge middle" set:text={t.sweep} />
    <rect {...box(528, 320, 192, 80)} rx="7.5" class="box"></rect>
    <text x="624" y="346" class="label" set:text={t.api} />
    <text x="624" y="365" class="edge middle" set:text={t.local} />
    <text x="624" y="383" class="path" set:text="backtest_lab/api" />
    <path class="line" d="M624.5 320V240" marker-end={`url(#${head.h})`}></path>
  </svg>

  <svg
    class="narrow"
    width="358"
    height="752"
    viewBox="0 0 358 752"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.v}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(0, 0, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="26" class="label" set:text={t.workflow} />
    <text x="107" y="45" class="edge middle" set:text={t.actions} />
    <text x="107" y="63" class="path" set:text="data.yml" />
    <path class="line" d="M107.5 80V112" marker-end={`url(#${head.v})`}></path>
    <rect {...box(0, 112, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="138" class="label" set:text={t.update} />
    <text x="107" y="157" class="edge middle" set:text={t.fetch} />
    <text x="107" y="175" class="path" set:text="backtest_lab/data" />
    <path class="line" d="M107.5 192V224" marker-end={`url(#${head.v})`}></path>
    <path d={storeV.body} class="box"></path>
    <ellipse {...storeV.face} class="box"></ellipse>
    <text x="107" y="266" class="label" set:text={t.store} />
    <text x="107" y="284" class="path" set:text="data/" />
    <path class="line" d="M107.5 304V336" marker-end={`url(#${head.v})`}></path>

    <rect {...box(0, 336, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="362" class="label" set:text={t.engine} />
    <text x="107" y="381" class="edge middle" set:text={t.fills} />
    <text x="107" y="399" class="path" set:text="backtest_lab/engine" />
    <rect {...box(238, 336, 120, 80)} rx="7.5" class="box"></rect>
    <text x="298" y="372" class="label" set:text={t.api} />
    <text x="298" y="391" class="edge middle" set:text={t.local} />
    <path class="line" d="M238 376.5H214" marker-end={`url(#${head.v})`}></path>
    <path class="line" d="M107.5 416V448" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="436" class="edge" set:text={t.returns} />

    <rect {...box(0, 448, 214, 80)} rx="7.5" class="box core"></rect>
    <text x="107" y="474" class="label" set:text={t.validation} />
    <text x="107" y="493" class="edge middle" set:text={t.checks} />
    <text x="107" y="511" class="path" set:text="backtest_lab/validation" />
    <path class="line" d="M107.5 528V560" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="548" class="edge" set:text={t.reports} />
    <rect {...box(0, 560, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="586" class="label" set:text={t.results} />
    <text x="107" y="605" class="edge middle" set:text={t.frozen} />
    <text x="107" y="623" class="path" set:text="results/demo" />
    <path class="line" d="M107.5 640V672" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="660" class="edge" set:text={t.reads} />

    <rect {...box(0, 672, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="698" class="label" set:text={t.dashboard} />
    <text x="107" y="717" class="edge middle" set:text={t.pages} />
    <text x="107" y="735" class="path" set:text="web" />
    <path
      class="link"
      d="M214 712.5H346.5V416"
      marker-end={`url(#${head.v})`}
    ></path>
    <text x="338" y="560" class="edge end" set:text={t.sweep} />
  </svg>
</div>

<style>
  .diagram {
    container-type: inline-size;
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    font-family: inherit;
  }

  .wide {
    display: none;
  }

  @container (min-width: 720px) {
    .wide {
      display: block;
      width: 100%;
    }

    .narrow {
      display: none;
    }
  }

  .region {
    fill: var(--color-surface);
  }

  .box {
    fill: var(--color-bg-subtle);
    stroke: var(--color-border-strong);
  }

  /* The one use of the accent: the overfitting checks, what the project is
     for. */
  .core {
    fill: var(--color-accent-subtle);
    stroke: var(--color-accent-line);
  }

  .line {
    fill: none;
    stroke: var(--color-border-strong);
  }

  /* Custom sweeps exist only when the project runs locally. */
  .link {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-dasharray: 4 4;
  }

  .head {
    fill: var(--color-text-muted);
  }

  /* Box labels and paths are centred on their x; edge labels start at it
     unless marked .middle or .end. */
  .label,
  .path,
  .middle {
    text-anchor: middle;
  }

  .end {
    text-anchor: end;
  }

  .label {
    fill: var(--color-text);
    font-size: 14px;
    font-weight: 500;
  }

  .path {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .edge {
    fill: var(--color-text-muted);
    font-size: 12px;
  }

  .region-label {
    fill: var(--color-text-muted);
    font-size: 13px;
    font-weight: 500;
  }
</style>
