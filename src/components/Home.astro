---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'
import { byOrder, repoName } from '../lib/projects'
import { getRelativeLocaleUrl } from 'astro:i18n'
import ProjectCard from './ProjectCard.astro'
import Tags from './Tags.astro'
import Text from './Text.astro'

const lang = toLang(Astro.currentLocale)
const all = byOrder(await getCollection('projects'))
const projects = all.filter((p) => !p.data.early)
const earlier = all.filter((p) => p.data.early)
const home = (await getEntry('home', 'home'))!.data
---

<Base title="Aaron Yang" description={t(lang, 'description')}>
  <div class="backdrop" aria-hidden="true">
    <canvas></canvas>
  </div>

  <section class="intro">
    <h1 class="rise">{home.headline[lang]}</h1>
    <p class="lede rise" style="--rise: 1">
      {home.intro[lang]}
    </p>
    <dl class="areas rise" style="--rise: 2">
      {home.areas.map((area) => (
        <div>
          <dt>{area.title[lang]}</dt>
          <dd>
            <Text value={area.body[lang]} />
            {area.repo && <a href={area.repo}>{repoName(area.repo)}</a>}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/* The entrance is on the children: a link to #projects aims at the
       section's box, which must not move. */}
  <section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title" class="rise" style="--rise: 3">
      {t(lang, 'projects')}
    </h2>
    <div class="list rise" style="--rise: 3">
      {projects.map((project, i) => (
        <ProjectCard {project} {lang} featured={i === 0} />
      ))}
    </div>
  </section>

  <section class="earlier reveal" aria-labelledby="earlier-title">
    <h2 id="earlier-title">{t(lang, 'earlier')}</h2>
    <ul>
      {earlier.map((project) => (
        <li>
          <h3>
            <a href={getRelativeLocaleUrl(lang, `projects/${project.id}/`)}>
              {project.data.title}
            </a>
          </h3>
          <p>
            <Text value={project.data.summary[lang]} />
          </p>
          <Tags tags={project.data.tags.map((tag) => tag[lang])} />
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { mountBackground } from '../gl/background'

  const canvas = document.querySelector<HTMLCanvasElement>('.backdrop canvas')
  if (canvas) mountBackground(canvas)
</script>

<style>
  /* The background (D015): one screen high at the top of the page, behind
     the header and the introduction. The shader fades it into the page
     itself, dithered; a CSS mask would band. The gradients show until the
     canvas draws and stay when WebGL2 is unavailable. They are the shader's
     glows where they start, each Gaussian drawn as a linear fall to
     transparent over 1.6 radii, which meets it at one radius. */
  .backdrop {
    --radius: calc(1.6 * (50vw + 50svh));

    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 100svh;
    background:
      radial-gradient(
        calc(0.34 * var(--radius)) calc(0.28 * var(--radius)) at 80% -10%,
        var(--color-backdrop-strong),
        transparent
      ),
      radial-gradient(
        calc(0.4 * var(--radius)) calc(0.3 * var(--radius)) at 92% -6%,
        var(--color-backdrop-tint),
        transparent
      ),
      radial-gradient(
        calc(0.42 * var(--radius)) calc(0.3 * var(--radius)) at 12% -12%,
        var(--color-backdrop-tint),
        transparent
      );
    pointer-events: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    contain: strict;
    opacity: 0;
  }

  canvas.ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    canvas {
      transition: opacity 1s var(--ease-out);
    }
  }

  /* Forced colours turn the shader's colours into the text colour. */
  @media (forced-colors: active) {
    .backdrop {
      display: none;
    }
  }

  .intro {
    padding-block: var(--space-6) var(--space-7);
  }

  /* Chinese breaks only between phrases, and a phone takes a step down so
     the headline leaves room for the introduction. The Chinese headline is
     one phrase of eleven characters, sized to fit a line at 320 px. */
  h1 {
    max-width: 20em;
    font-size: min(var(--step-4), 8.8vw);
    line-height: 1.1;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  h1:lang(zh) {
    font-size: min(var(--step-4), 8.1vw);
  }

  /* A wide introduction ends evenly rather than with a word or two, and
     Chinese breaks between phrases. */
  @media (min-width: 48rem) {
    h1,
    h1:lang(zh) {
      font-size: var(--step-5);
    }

    .lede {
      text-wrap: balance;
      word-break: keep-all;
    }
  }

  .lede {
    max-width: 36em;
    margin-block: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--step-1);
  }

  /* One area a row on a phone, three on a wide screen. */
  .areas {
    display: grid;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }

  @media (min-width: 64rem) {
    .areas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .areas div {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  dt {
    font-weight: 600;
  }

  dd {
    max-width: var(--width-prose);
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  /* The repository of an area whose work has no project page yet. */
  dd a {
    display: block;
    width: fit-content;
    margin-top: var(--space-1);
    color: var(--color-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }

  dd a:hover {
    color: var(--color-text);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
  }

  .list {
    display: grid;
    gap: var(--space-3);
  }

  /* Two cards a row on a wide screen; the first project takes a row alone. */
  @media (min-width: 48rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .list > :global(.featured) {
      grid-column: 1 / -1;
    }
  }

  /* Earlier projects: text only, set like the areas above, one a row until
     three fit side by side. */
  .earlier {
    margin-top: var(--space-6);
  }

  .earlier ul {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .earlier ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .earlier li {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .earlier h3 {
    font-size: var(--step-0);
  }

  .earlier a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .earlier a:hover {
    color: var(--color-accent);
  }

  .earlier p {
    max-width: var(--width-prose);
    margin-block: var(--space-1) var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
