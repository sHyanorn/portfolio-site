---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'
import Text from './Text.astro'

const lang = toLang(Astro.currentLocale)
const about = (await getEntry('about', 'about'))!.data
const { education, areas, tools, direction } = about
// The year range stays on one line, without invisible characters in the
// text. The parts form one expression, as line breaks between them would
// render as spaces, which show in Chinese.
const YEARS = '2024–2027'
const d = education.degree[lang].split(YEARS)
if (d.length !== 2) throw new Error(`degree must name ${YEARS} once`)
// "Projects: a, b." and "项目：a、b。"
const punct = {
  en: { colon: ': ', comma: ', ', stop: '.' },
  zh: { colon: '：', comma: '、', stop: '。' },
}[lang]
---

<Base
  title={`${t(lang, 'about')} · Aaron Yang`}
  description={t(lang, 'aboutDescription')}
>
  <h1 class="rise">{t(lang, 'about')}</h1>

  <section class="row rise" style="--rise: 1" aria-labelledby="education">
    <h2 id="education">{education.title[lang]}</h2>
    <div>
      <p class="school">{education.school[lang]}</p>
      <p class="meta">{[d[0], <span class="years">{YEARS}</span>, d[1]]}</p>
      <p class="location">{education.location[lang]}</p>
    </div>
  </section>

  {areas.map((area, i) => (
    <section class="row reveal" aria-labelledby={`area-${i + 1}`}>
      <h2 id={`area-${i + 1}`}>{area.title[lang]}</h2>
      <div>
        <ul>
          {area.items.map((item) => (
            <li>
              <Text value={item[lang]} />
            </li>
          ))}
        </ul>
        <p class="projects">
          {[
            t(lang, area.projects.length > 1 ? 'projects' : 'project'),
            punct.colon,
            ...area.projects.flatMap((id, j) => [
              j > 0 && punct.comma,
              <a href={getRelativeLocaleUrl(lang, `projects/${id}/`)}>{id}</a>,
            ]),
            punct.stop,
          ]}
        </p>
      </div>
    </section>
  ))}

  <section class="row reveal" aria-labelledby="tools">
    <h2 id="tools">{tools.title[lang]}</h2>
    <p>{tools.body[lang]}</p>
  </section>

  <section class="row reveal" aria-labelledby="direction">
    <h2 id="direction">{direction.title[lang]}</h2>
    <p>{direction.body[lang]}</p>
  </section>
</Base>

<style>
  h1 {
    padding-top: var(--space-4);
    font-size: var(--step-5);
    line-height: 1.1;
  }

  section {
    margin-top: var(--space-6);
  }

  section :is(p, ul) {
    max-width: var(--width-prose);
  }

  ul {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
  }

  li::marker {
    color: var(--color-text-muted);
  }

  .projects {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .projects a {
    color: var(--color-accent);
  }

  /* A wide screen puts each heading beside its text, as on project pages. */
  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-line);
    }

    .row + .row {
      margin-top: var(--space-5);
    }

    .row h2 {
      margin: 0;
      font-size: var(--step-2);
    }
  }

  h2 {
    margin-bottom: var(--space-2);
    font-size: var(--step-2);
  }

  .school {
    font-weight: 500;
  }

  .meta,
  .location {
    color: var(--color-text-muted);
  }

  .years {
    white-space: nowrap;
  }
</style>
