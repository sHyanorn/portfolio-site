---
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="inner bleed">
    <p>© {year} Aaron Yang</p>
    <ul class="links">
      <li>
        <a href="mailto:yang341133@gmail.com">yang341133@gmail.com</a>
      </li>
      <li>
        <a href="https://github.com/sHyanorn">GitHub</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* 44 px to tap, while the focus ring keeps to the text. */
  a {
    display: inline-block;
    position: relative;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  a::after {
    content: '';
    position: absolute;
    inset: calc((1lh - 44px) / 2) 0;
  }

  a:hover {
    color: var(--color-text);
  }
</style>
