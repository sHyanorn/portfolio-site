---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '../lib/i18n'
import Tags from './Tags.astro'
import Text from './Text.astro'

interface Props {
  project: CollectionEntry<'projects'>
  lang: Lang
}

const { project, lang } = Astro.props
const p = project.data
---

<article class="card">
  <h3>
    <a href={getRelativeLocaleUrl(lang, `projects/${project.id}/`)}>
      {p.title}
    </a>
  </h3>
  <p>
    <Text value={p.summary[lang]} />
  </p>
  <div class="tags">
    <Tags tags={p.tags.map((tag) => tag[lang])} />
  </div>
</article>

<style>
  /* The title link covers the whole card (Inclusive Components, "Cards"). */
  .card {
    position: relative;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    transition:
      border-color var(--duration-fast),
      background-color var(--duration-fast);
  }

  .card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  h3 {
    font-size: var(--step-1);
  }

  a {
    text-decoration: none;
  }

  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  p {
    max-width: var(--width-prose);
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .tags {
    margin-top: var(--space-2);
  }
</style>
