---
import '../styles/tokens.css'
import '../styles/base.css'
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseHead from '../components/BaseHead.astro'
import { LANG_TAG, otherLang, pagePath, t, toLang } from '../lib/i18n'

interface Props {
  title: string
  description: string
  /** False on a page with no counterpart in the other language, such as the 404 page. */
  alternates?: boolean
}

const { title, description, alternates = true } = Astro.props
const lang = toLang(Astro.currentLocale)
const other = otherLang(lang)
---

<!doctype html>
<html lang={LANG_TAG[lang]}>
  <head>
    <BaseHead {title} {description} {lang} {alternates} />
  </head>
  <body>
    <header>
      <nav>
        <a href={getRelativeLocaleUrl(lang)}>Aaron Yang</a>
        {alternates && (
          <a
            href={getRelativeLocaleUrl(other, pagePath(Astro.url.pathname))}
            hreflang={LANG_TAG[other]}
            lang={LANG_TAG[other]}
          >
            {t(lang, 'language')}
          </a>
        )}
      </nav>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  main {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: var(--space-7) var(--gutter);
  }

  main h1 {
    margin-bottom: var(--space-3);
    font-size: var(--step-4);
  }

  main ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }
</style>
