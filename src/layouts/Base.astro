---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/motion.css'
import BaseHead from '../components/BaseHead.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { LANG_TAG, t, toLang } from '../lib/i18n'

interface Props {
  title: string
  description: string
  /** False on a page with no counterpart in the other language, such as the 404 page. */
  alternates?: boolean
}

const { title, description, alternates = true } = Astro.props
const lang = toLang(Astro.currentLocale)
---

<!doctype html>
<html lang={LANG_TAG[lang]}>
  <head>
    <BaseHead {title} {description} {lang} {alternates} />
  </head>
  <body>
    <a class="skip" href="#main">
      {t(lang, 'skip')}
    </a>
    <SiteHeader {lang} {alternates} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1;
    padding-top: var(--space-5);
  }

  .skip {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-2);
    background: var(--color-accent-solid);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    translate: 0 calc(-100% - var(--space-2));
  }

  .skip:focus-visible {
    translate: none;
  }
</style>
