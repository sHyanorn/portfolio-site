---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { CollectionEntry } from 'astro:content'
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import Base from '../layouts/Base.astro'
import { publishedArticles } from '../lib/articles'
import { t, toLang } from '../lib/i18n'
import Demo from './Demo.astro'
import DemoPreload from './DemoPreload.astro'
import RepoLink from './RepoLink.astro'
import Tags from './Tags.astro'
import Text from './Text.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const p = Astro.props.project.data
const lang = toLang(Astro.currentLocale)
const article = (await publishedArticles()).find(
  (a) => a.data.project === Astro.props.project.id,
)

// Each project's diagram is drawn by hand in architecture/<slug>.astro (D013).
const diagrams = import.meta.glob<{ default: AstroComponentFactory }>(
  './architecture/*.astro',
  { eager: true },
)
const Diagram =
  diagrams[`./architecture/${Astro.props.project.id}.astro`]?.default
if (!Diagram)
  throw new Error(`No architecture diagram for ${Astro.props.project.id}`)
const hasRest = 'images' in p.demo && p.demo.images.length > 1
const labels = Object.fromEntries(
  Object.entries(p.architecture.labels).map(([key, label]) => [
    key,
    label[lang],
  ]),
)
---

<Base
  title={`${p.title} · Aaron Yang`}
  description={p.summary[lang]}
  image={`og/${Astro.props.project.id}.png`}
>
  <DemoPreload slot="head" demo={p.demo} />
  <article class="project">
    <div class="hero">
      <header class="intro">
        <h1 class="rise">{p.title}</h1>
        <p class="summary rise" style="--rise: 1">
          <Text value={p.summary[lang]} />
        </p>
        <div class="tags rise" style="--rise: 2">
          <Tags tags={p.tags.map((tag) => tag[lang])} />
        </div>
      </header>

      <div class="demo rise" style="--rise: 3">
        <Demo demo={p.demo} {lang} part="first" />
      </div>
    </div>

    {hasRest && (
      <div class="gallery reveal">
        <Demo demo={p.demo} {lang} part="rest" />
      </div>
    )}

    <section class="reveal" aria-labelledby="metrics">
      <h2 id="metrics">{t(lang, 'metrics')}</h2>
      <dl class="metrics">
        {p.metrics.items.map((m) => (
          <div>
            <dt>
              <Text value={m.label[lang]} />
            </dt>
            <dd>{m.value[lang]}</dd>
          </div>
        ))}
      </dl>
      <p class="note">
        <Text value={p.metrics.note[lang]} />
        <a href={p.metrics.source.url}>{p.metrics.source.label[lang]}</a>
      </p>
    </section>

    <section class="row reveal" aria-labelledby="problem">
      <h2 id="problem">{t(lang, 'problem')}</h2>
      <div class="body">
        {p.problem.map((para) => (
          <p>
            <Text value={para[lang]} />
          </p>
        ))}
      </div>
    </section>

    <section class="row reveal" aria-labelledby="architecture">
      <h2 id="architecture">{t(lang, 'architecture')}</h2>
      <div class="body">
        <Diagram {labels} id="architecture-diagram" />
        <p class="described">
          <Text value={p.architecture.description[lang]} />
        </p>
      </div>
    </section>

    <section class="row reveal" aria-labelledby="decisions">
      <h2 id="decisions">{t(lang, 'decisions')}</h2>
      <div class="body">
        <ul class="items">
          {p.decisions.items.map((d) => (
            <li>
              <h3>
                <span class="id">{d.id}</span>
                {d.title[lang]}
              </h3>
              <p>
                <Text value={d.body[lang]} />
              </p>
            </li>
          ))}
        </ul>
        <p class="note">
          <a href={p.decisions.source}>{t(lang, 'decisionLog')}</a>
        </p>
      </div>
    </section>

    <section class="row reveal" aria-labelledby="challenges">
      <h2 id="challenges">{t(lang, 'challenges')}</h2>
      <div class="body">
        <ul class="items">
          {p.challenges.map((c) => (
            <li>
              <h3>{c.title[lang]}</h3>
              <p>
                <Text value={c.body[lang]} />
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="row links reveal">
      <div class="body">
        {article && (
          <p class="article">
            <span>{t(lang, 'article')}</span>
            <a
              href={getRelativeLocaleUrl(lang, `articles/${article.id}/`)}
              lang="en"
            >
              {article.data.title}
            </a>
          </p>
        )}
        <RepoLink href={p.repo} {lang} />
      </div>
    </footer>
  </article>
</Base>

<style>
  .project {
    --section-gap: clamp(4rem, 3rem + 4vw, 6rem);
    padding-bottom: var(--space-4);
  }

  .project > * + * {
    margin-top: var(--section-gap);
  }

  .demo {
    margin-top: var(--space-5);
  }

  /* Later screenshots follow the first at the gap between screenshots, so
     they read as one set; the class outranks the section gap. */
  .project > * + .gallery {
    margin-top: var(--space-5);
  }

  .intro {
    padding-top: var(--space-4);
  }

  h1 {
    font-size: var(--step-5);
    line-height: 1.1;
  }

  .summary {
    max-width: var(--width-prose);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .tags {
    margin-top: var(--space-3);
  }

  .note {
    max-width: var(--width-prose);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .note a {
    display: block;
    width: fit-content;
    color: var(--color-accent);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
  }

  .body > p {
    max-width: var(--width-prose);
  }

  .body > p + p {
    margin-top: var(--space-2);
  }

  .described {
    margin-top: var(--space-3);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-line);
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--color-bg);
  }

  .metrics dd {
    font-size: var(--step-3);
    white-space: nowrap;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .metrics dt {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .summary:lang(zh),
  .metrics dt:lang(zh) {
    line-height: 1.75;
  }

  .items {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: var(--step-0);
  }

  .items p {
    max-width: var(--width-prose);
    margin-top: var(--space-1);
  }

  .id {
    margin-right: 0.5em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--width-prose);
    margin-bottom: var(--space-4);
  }

  .article span {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .article a {
    color: var(--color-accent);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.4;
  }

  /* Two a row once the longest values fit half the column. */
  @media (max-width: 36rem) {
    .metrics {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* A wide screen puts the intro beside the first demo and each section's
     title in a column of its own beside it. The
     first demo then sits below the header alone, so it may take all but
     the header, the page padding and a line to spare. */
  @media (min-width: 64rem) {
    .hero {
      --demo-reserve: 12rem;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-6);
      align-items: start;
    }

    .hero .demo {
      margin-top: var(--space-4);
    }

    .row {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-5);
    }

    /* Decisions and challenges sit two a row, so the column is filled. */
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-6);
    }

    .row h2 {
      position: sticky;
      top: var(--space-4);
      align-self: start;
      margin: 0;
      font-size: var(--step-2);
    }

    .links .body {
      grid-column: 2;
    }
  }

  /* The metrics take one row from 80rem; below it, the longest values do
     not fit a quarter of the column. */
  @media (min-width: 80rem) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
