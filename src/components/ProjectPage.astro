---
import { getImage } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'
import { withBase } from '../lib/paths'
import Tags from './Tags.astro'
import Text from './Text.astro'

interface Props {
  project: CollectionEntry<'projects'>
}

const p = Astro.props.project.data
const lang = toLang(Astro.currentLocale)
const poster = await getImage({ src: p.demo.poster, format: 'avif' })

// Each project's diagram is drawn by hand in architecture/<slug>.astro (D013).
const diagrams = import.meta.glob<{ default: AstroComponentFactory }>(
  './architecture/*.astro',
  { eager: true },
)
const Diagram =
  diagrams[`./architecture/${Astro.props.project.id}.astro`]?.default
if (!Diagram)
  throw new Error(`No architecture diagram for ${Astro.props.project.id}`)
const labels = Object.fromEntries(
  Object.entries(p.architecture.labels).map(([key, label]) => [
    key,
    label[lang],
  ]),
)
---

<Base title={`${p.title} · Aaron Yang`} description={p.summary[lang]}>
  <article class="project">
    <header class="intro">
      <h1 class="rise">{p.title}</h1>
      <p class="summary rise" style="--rise: 1">
        <Text value={p.summary[lang]} />
      </p>
      <div class="tags rise" style="--rise: 2">
        <Tags tags={p.tags.map((tag) => tag[lang])} />
      </div>
    </header>

    <figure
      class="demo rise"
      style={`--rise: 3; --ratio: ${p.demo.poster.width} / ${p.demo.poster.height}`}
    >
      <video
        controls
        muted
        loop
        playsinline
        preload="none"
        poster={poster.src}
        width={p.demo.poster.width}
        height={p.demo.poster.height}
      >
        <source src={withBase(p.demo.video)} type="video/mp4" />
      </video>
      <figcaption>
        <Text value={p.demo.caption[lang]} />
      </figcaption>
    </figure>

    <section class="reveal" aria-labelledby="metrics">
      <h2 id="metrics">{t(lang, 'metrics')}</h2>
      <dl class="metrics">
        {p.metrics.items.map((m) => (
          <div>
            <dt>
              <Text value={m.label[lang]} />
            </dt>
            <dd>{m.value[lang]}</dd>
          </div>
        ))}
      </dl>
      <p class="note">
        <Text value={p.metrics.note[lang]} />
        <a href={p.metrics.source}>{t(lang, 'benchmarks')}</a>
      </p>
    </section>

    <section class="reveal" aria-labelledby="problem">
      <h2 id="problem">{t(lang, 'problem')}</h2>
      {p.problem.map((para) => (
        <p>
          <Text value={para[lang]} />
        </p>
      ))}
    </section>

    <section class="reveal" aria-labelledby="architecture">
      <h2 id="architecture">{t(lang, 'architecture')}</h2>
      <Diagram {labels} id="architecture-diagram" />
      <p class="described">
        <Text value={p.architecture.description[lang]} />
      </p>
    </section>

    <section class="reveal" aria-labelledby="decisions">
      <h2 id="decisions">{t(lang, 'decisions')}</h2>
      <ul class="items">
        {p.decisions.items.map((d) => (
          <li>
            <h3>
              <span class="id">{d.id}</span>
              {d.title[lang]}
            </h3>
            <p>
              <Text value={d.body[lang]} />
            </p>
          </li>
        ))}
      </ul>
      <p class="note">
        <a href={p.decisions.source}>{t(lang, 'decisionLog')}</a>
      </p>
    </section>

    <section class="reveal" aria-labelledby="challenges">
      <h2 id="challenges">{t(lang, 'challenges')}</h2>
      <ul class="items">
        {p.challenges.map((c) => (
          <li>
            <h3>{c.title[lang]}</h3>
            <p>
              <Text value={c.body[lang]} />
            </p>
          </li>
        ))}
      </ul>
    </section>

    <footer class="links reveal">
      <a class="repo" href={p.repo}>
        {t(lang, 'repo')}
      </a>
    </footer>
  </article>
</Base>

<style>
  .project {
    --section-gap: clamp(4rem, 3rem + 4vw, 6rem);
    padding-bottom: var(--space-4);
  }

  .project > * + * {
    margin-top: var(--section-gap);
  }

  /* No taller than the first screen leaves below the header and the page
     intro (about 24rem, plus 2rem to spare), so the controls show without
     scrolling; the width follows the video's aspect ratio. */
  .project > .demo {
    width: min(100%, max(16rem, 100svh - 26rem) * var(--ratio));
    margin: var(--space-5) auto 0;
  }

  .intro {
    padding-top: var(--space-4);
  }

  h1 {
    font-size: var(--step-5);
    line-height: 1.1;
  }

  .summary {
    max-width: var(--width-prose);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .tags {
    margin-top: var(--space-3);
  }

  .demo video {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-surface);
  }

  figcaption,
  .note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .note a {
    display: block;
    width: fit-content;
    color: var(--color-accent);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
  }

  section > p {
    max-width: var(--width-prose);
  }

  section > p + p {
    margin-top: var(--space-2);
  }

  .described {
    margin-top: var(--space-3);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-line);
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--color-bg);
  }

  .metrics dd {
    font-size: var(--step-3);
    white-space: nowrap;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .metrics dt {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .summary:lang(zh),
  .metrics dt:lang(zh) {
    line-height: 1.75;
  }

  .items {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: var(--step-0);
  }

  .items p {
    max-width: var(--width-prose);
    margin-top: var(--space-1);
  }

  .id {
    margin-right: 0.5em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-5);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--duration-fast),
      background-color var(--duration-fast);
  }

  .repo:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  @media (max-width: 30rem) {
    .metrics {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
