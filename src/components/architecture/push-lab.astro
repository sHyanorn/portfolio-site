---
// Architecture of push-lab, drawn by hand in two variants: a wide one drawn
// at 720 px and scaled to fit containers from 680 px up, where its smallest
// text is still above 11 px, and a narrow one drawn at 358 px for narrower
// ones.
interface Props {
  labels: Record<string, string>
  /** Prefix for the arrowhead marker ids, unique on the page. */
  id: string
}

const KEYS = [
  'data',
  'dataSub',
  'recall',
  'recallSub',
  'rank',
  'rankSub',
  'uplift',
  'upliftSub',
  'sim',
  'simSub',
  'policy',
  'policySub',
  'ope',
  'opeSub',
  'report',
  'reportSub',
  'topEdge',
  'sendsEdge',
  'logsEdge',
  'tierAEdge',
  'estimatesEdge',
  'sweepsEdge',
] as const

const { labels, id } = Astro.props
const missing = KEYS.filter((key) => !labels[key])
if (missing.length > 0)
  throw new Error(
    `PushLab: missing label${missing.length > 1 ? 's' : ''} ${missing.join(', ')}`,
  )
const t = labels as Record<(typeof KEYS)[number], string>

// A box over whole pixels x..x+w, y..y+h, with its 1 px stroke inside.
const box = (x: number, y: number, w: number, h: number) => ({
  x: x + 0.5,
  y: y + 0.5,
  width: w - 1,
  height: h - 1,
})

// Marker ids are per instance and per variant: a hidden SVG's markers do not render.
const head = { h: `${id}-head-h`, v: `${id}-head-v` }
// Text goes in through set:text, so formatting adds no spaces that would
// shift centred labels. The candidate flows along the top row and down to
// the policy, which runs in the simulator; every result ends in the report.
---

<div class="diagram">
  <svg
    class="wide"
    width="720"
    height="560"
    viewBox="0 0 720 560"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.h}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(0, 0, 192, 80)} rx="7.5" class="box"></rect>
    <text x="96" y="26" class="label" set:text={t.data} />
    <text x="96" y="45" class="edge middle" set:text={t.dataSub} />
    <text x="96" y="63" class="path" set:text="push_lab/data" />
    <path class="line" d="M192 40.5H264" marker-end={`url(#${head.h})`}></path>
    <rect {...box(264, 0, 192, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="26" class="label" set:text={t.recall} />
    <text x="360" y="45" class="edge middle" set:text={t.recallSub} />
    <text x="360" y="63" class="path" set:text="push_lab/recall" />
    <path class="line" d="M456 40.5H528" marker-end={`url(#${head.h})`}></path>
    <rect {...box(528, 0, 192, 80)} rx="7.5" class="box"></rect>
    <text x="624" y="26" class="label" set:text={t.rank} />
    <text x="624" y="45" class="edge middle" set:text={t.rankSub} />
    <text x="624" y="63" class="path" set:text="push_lab/rank" />

    <path class="line" d="M96.5 80V160" marker-end={`url(#${head.h})`}></path>
    <path class="line" d="M624.5 80V160" marker-end={`url(#${head.h})`}></path>
    <text x="632" y="124" class="edge" set:text={t.topEdge} />

    <rect {...box(0, 160, 192, 80)} rx="7.5" class="box"></rect>
    <text x="96" y="186" class="label" set:text={t.uplift} />
    <text x="96" y="205" class="edge middle" set:text={t.upliftSub} />
    <text x="96" y="223" class="path" set:text="push_lab/uplift" />
    <rect {...box(264, 160, 192, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="186" class="label" set:text={t.sim} />
    <text x="360" y="205" class="edge middle" set:text={t.simSub} />
    <text x="360" y="223" class="path" set:text="push_lab/sim" />
    <path class="line" d="M528 188.5H456" marker-end={`url(#${head.h})`}></path>
    <text x="492" y="180" class="edge middle" set:text={t.sendsEdge} />
    <path class="line" d="M456 212.5H528" marker-end={`url(#${head.h})`}></path>
    <text x="492" y="230" class="edge middle" set:text={t.logsEdge} />
    <rect {...box(528, 160, 192, 80)} rx="7.5" class="box"></rect>
    <text x="624" y="186" class="label" set:text={t.policy} />
    <text x="624" y="205" class="edge middle" set:text={t.policySub} />
    <text x="624" y="223" class="path" set:text="push_lab/policy" />

    <path class="line" d="M360.5 240V320" marker-end={`url(#${head.h})`}></path>
    <text x="368" y="284" class="edge" set:text={t.logsEdge} />

    <rect {...box(264, 320, 192, 80)} rx="7.5" class="box"></rect>
    <text x="360" y="346" class="label" set:text={t.ope} />
    <text x="360" y="365" class="edge middle" set:text={t.opeSub} />
    <text x="360" y="383" class="path" set:text="push_lab/ope" />

    <path class="line" d="M96.5 240V480" marker-end={`url(#${head.h})`}></path>
    <text x="104" y="364" class="edge" set:text={t.tierAEdge} />
    <path class="line" d="M360.5 400V480" marker-end={`url(#${head.h})`}></path>
    <text x="368" y="444" class="edge" set:text={t.estimatesEdge} />
    <path class="line" d="M624.5 240V480" marker-end={`url(#${head.h})`}></path>
    <text x="632" y="364" class="edge" set:text={t.sweepsEdge} />

    <rect {...box(0, 480, 720, 80)} rx="7.5" class="box core"></rect>
    <text x="360" y="506" class="label" set:text={t.report} />
    <text x="360" y="525" class="edge middle" set:text={t.reportSub} />
    <text x="360" y="543" class="path" set:text="push_lab/report" />
  </svg>

  <svg
    class="narrow"
    width="358"
    height="752"
    viewBox="0 0 358 752"
    aria-hidden="true"
  >
    <defs>
      <marker
        id={head.v}
        viewBox="0 0 8 7"
        refX="8"
        refY="3.5"
        markerWidth="8"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto"
      >
        <path class="head" d="M0 0L8 3.5L0 7Z"></path>
      </marker>
    </defs>

    <rect {...box(0, 0, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="26" class="label" set:text={t.data} />
    <text x="107" y="45" class="edge middle" set:text={t.dataSub} />
    <text x="107" y="63" class="path" set:text="push_lab/data" />
    <path class="line" d="M214 40.5H238" marker-end={`url(#${head.v})`}></path>
    <rect {...box(238, 0, 120, 80)} rx="7.5" class="box"></rect>
    <text x="298" y="36" class="label" set:text={t.uplift} />
    <text x="298" y="55" class="edge middle" set:text={t.upliftSub} />
    <path class="line" d="M107.5 80V112" marker-end={`url(#${head.v})`}></path>

    <rect {...box(0, 112, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="138" class="label" set:text={t.recall} />
    <text x="107" y="157" class="edge middle" set:text={t.recallSub} />
    <text x="107" y="175" class="path" set:text="push_lab/recall" />
    <path class="line" d="M107.5 192V224" marker-end={`url(#${head.v})`}></path>

    <rect {...box(0, 224, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="250" class="label" set:text={t.rank} />
    <text x="107" y="269" class="edge middle" set:text={t.rankSub} />
    <text x="107" y="287" class="path" set:text="push_lab/rank" />
    <path class="line" d="M107.5 304V336" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="324" class="edge" set:text={t.topEdge} />

    <rect {...box(0, 336, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="362" class="label" set:text={t.policy} />
    <text x="107" y="381" class="edge middle" set:text={t.policySub} />
    <text x="107" y="399" class="path" set:text="push_lab/policy" />
    <path class="line" d="M80.5 416V448" marker-end={`url(#${head.v})`}></path>
    <text x="72" y="436" class="edge end" set:text={t.sendsEdge} />
    <path class="line" d="M134.5 448V416" marker-end={`url(#${head.v})`}></path>
    <text x="142" y="436" class="edge" set:text={t.logsEdge} />
    <path
      class="line"
      d="M214 376.5H262.5V672"
      marker-end={`url(#${head.v})`}
    ></path>
    <text x="256" y="436" class="edge end" set:text={t.sweepsEdge} />

    <rect {...box(0, 448, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="474" class="label" set:text={t.sim} />
    <text x="107" y="493" class="edge middle" set:text={t.simSub} />
    <text x="107" y="511" class="path" set:text="push_lab/sim" />
    <path class="line" d="M107.5 528V560" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="548" class="edge" set:text={t.logsEdge} />

    <rect {...box(0, 560, 214, 80)} rx="7.5" class="box"></rect>
    <text x="107" y="586" class="label" set:text={t.ope} />
    <text x="107" y="605" class="edge middle" set:text={t.opeSub} />
    <text x="107" y="623" class="path" set:text="push_lab/ope" />
    <path class="line" d="M107.5 640V672" marker-end={`url(#${head.v})`}></path>
    <text x="115" y="660" class="edge" set:text={t.estimatesEdge} />

    <path class="line" d="M298.5 80V672" marker-end={`url(#${head.v})`}></path>
    <text x="306" y="200" class="edge" set:text={t.tierAEdge} />

    <rect {...box(0, 672, 358, 80)} rx="7.5" class="box core"></rect>
    <text x="179" y="698" class="label" set:text={t.report} />
    <text x="179" y="717" class="edge middle" set:text={t.reportSub} />
    <text x="179" y="735" class="path" set:text="push_lab/report" />
  </svg>
</div>

<style>
  .diagram {
    container-type: inline-size;
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    font-family: inherit;
  }

  .wide {
    display: none;
  }

  @container (min-width: 680px) {
    .wide {
      display: block;
      width: 100%;
    }

    .narrow {
      display: none;
    }
  }

  .box {
    fill: var(--color-bg-subtle);
    stroke: var(--color-border-strong);
  }

  /* The one use of the accent: the report, where every number gets its
     evidence tier, what the project is for. */
  .core {
    fill: var(--color-accent-subtle);
    stroke: var(--color-accent-line);
  }

  .line {
    fill: none;
    stroke: var(--color-border-strong);
  }

  .head {
    fill: var(--color-text-muted);
  }

  /* Box labels and paths are centred on their x; edge labels start at it
     unless marked .middle or .end. */
  .label,
  .path,
  .middle {
    text-anchor: middle;
  }

  .end {
    text-anchor: end;
  }

  .label {
    fill: var(--color-text);
    font-size: 14px;
    font-weight: 500;
  }

  .path {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .edge {
    fill: var(--color-text-muted);
    font-size: 12px;
  }
</style>
