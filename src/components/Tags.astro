---
interface Props {
  tags: string[]
}
---

<ul class="tags">
  {Astro.props.tags.map((tag) => (
    <li>{tag}</li>
  ))}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0 0.75em;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: 1.75rem;
  }

  /* Forced colours drop the background; a border keeps the shape. */
  @media (forced-colors: active) {
    li {
      border: 1px solid;
    }
  }
</style>
