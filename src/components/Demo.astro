---
import { getImage, Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '../lib/i18n'
import { shotImage } from '../lib/shots'
import { withBase } from '../lib/paths'
import Text from './Text.astro'

interface Props {
  demo: CollectionEntry<'projects'>['data']['demo']
  lang: Lang
}

const { demo, lang } = Astro.props
// AVIF from the build (D013); screenshots also get a full-size copy to open.
const poster =
  'video' in demo
    ? await getImage({ src: demo.poster, format: 'avif' })
    : undefined
const shots =
  'images' in demo
    ? await Promise.all(
        demo.images.map(async (shot) => ({
          ...shot,
          variants: await Promise.all(
            [
              { src: shot.src, theme: shot.dark && 'light' },
              ...(shot.dark ? [{ src: shot.dark, theme: 'dark' }] : []),
            ].map(async (v) => ({
              ...v,
              full: await getImage({ src: v.src, format: 'avif' }),
            })),
          ),
        })),
      )
    : []
---

{'video' in demo ? (
  <figure style={`--ratio: ${demo.poster.width} / ${demo.poster.height}`}>
    <video
      controls
      muted
      loop
      playsinline
      preload="none"
      poster={poster!.src}
      width={demo.poster.width}
      height={demo.poster.height}
    >
      <source src={withBase(demo.video)} type="video/mp4" />
    </video>
    <figcaption>
      <Text value={demo.caption[lang]} />
    </figcaption>
  </figure>
) : (
  <div class="shots">
    {shots.map((shot, i) => (
      <figure style={`--ratio: ${shot.src.width} / ${shot.src.height}`}>
        {shot.variants.map((v) => (
          <a href={v.full.src} class={v.theme}>
            <Image
              {...shotImage(v.src)}
              alt={shot.alt[lang]}
              loading={i === 0 && !shot.dark ? 'eager' : 'lazy'}
            />
          </a>
        ))}
        <figcaption>
          <Text value={shot.caption[lang]} />
        </figcaption>
      </figure>
    ))}
  </div>
)}

<style>
  /* A video or screenshot is no taller than the first screen leaves below
     the header and the page intro (about 28rem with four lines of summary,
     plus a line to spare), so the first ends on the first screen; the width
     follows the aspect ratio. */
  figure {
    width: min(100%, max(16rem, 100svh - 30rem) * var(--ratio));
    margin-inline: auto;
  }

  /* Later screenshots are read after scrolling, so each only has to fit one
     screen with its caption. */
  figure + figure {
    width: min(100%, max(16rem, 100svh - 8rem) * var(--ratio));
  }

  video,
  img {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-3);
    background: var(--color-surface);
  }

  .shots {
    display: grid;
    gap: var(--space-5);
  }

  /* A block link, so its focus ring goes round the screenshot. */
  .shots a {
    display: block;
    border-radius: var(--radius-3);
  }

  /* A screenshot with a dark copy shows the one that matches the theme, and
     each links to its own full-size copy. Both copies load lazily, so the
     hidden one never loads; DemoPreload starts the first visible one early. */
  @media (prefers-color-scheme: dark) {
    .shots .light {
      display: none;
    }
  }

  @media not (prefers-color-scheme: dark) {
    .shots .dark {
      display: none;
    }
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
