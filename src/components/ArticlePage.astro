---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { render, type CollectionEntry } from 'astro:content'
import katexStyles from 'katex/dist/katex.min.css?url'
import Base from '../layouts/Base.astro'
import { projectOf } from '../lib/articles'
import { formatDate, formatMinutes, t, toLang } from '../lib/i18n'
import RepoLink from './RepoLink.astro'

interface Props {
  article: CollectionEntry<'articles'>
}

const { article } = Astro.props
const a = article.data
const lang = toLang(Astro.currentLocale)
const project = await projectOf(article)
const { Content, headings, remarkPluginFrontmatter } = await render(article)
const sections = headings.filter((h) => h.depth === 2)
---

<Base
  title={`${a.title} · Aaron Yang`}
  description={a.summary}
  published={a.date}
  image={`og/${project.id}.png`}
>
  {
    // Only articles with math load KaTeX's stylesheet and fonts (D005).
    a.math && <link slot="head" rel="stylesheet" href={katexStyles} />
  }
  <article class="article">
    <header class="intro">
      <h1 class="rise" lang="en">
        {a.title}
      </h1>
    </header>

    <aside class="aside rise" style="--rise: 1">
      <div class="facts">
        <p class="project">
          <span>{t(lang, 'project')}</span>
          <a href={getRelativeLocaleUrl(lang, `projects/${project.id}/`)}>
            {project.data.title}
          </a>
        </p>
        <p class="meta">
          <time datetime={a.date.toISOString().slice(0, 10)}>
            {formatDate(lang, a.date)}
          </time>
          <span aria-hidden="true">·</span>
          {formatMinutes(lang, remarkPluginFrontmatter.minutes)}
        </p>
      </div>
      {sections.length > 1 && (
        <nav class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title">{t(lang, 'contents')}</h2>
          <ol lang="en">
            {sections.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>

    <div class="prose rise" style="--rise: 2" lang="en">
      <Content />
    </div>

    <footer class="links">
      <RepoLink href={project.data.repo} {lang} />
    </footer>
  </article>
</Base>

<style>
  .article {
    padding-bottom: var(--space-4);
  }

  .intro {
    padding-top: var(--space-4);
  }

  h1 {
    max-width: var(--width-prose);
    font-size: var(--step-4);
    line-height: 1.15;
  }

  .aside {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .facts p {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
  }

  .facts a {
    color: var(--color-accent);
  }

  /* The contents list helps only beside the text; a phone reads on. */
  .toc {
    display: none;
  }

  .toc h2 {
    margin-bottom: var(--space-1);
    color: var(--color-text);
    font-size: var(--step--1);
  }

  .toc ol {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
    line-height: 1.4;
  }

  .toc a {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .toc a:hover {
    color: var(--color-text);
  }

  .prose {
    max-width: var(--width-prose);
    margin-top: var(--space-5);
  }

  /* The body is MDX, so its elements carry no scoped class. */
  .prose > :global(* + *) {
    margin-top: var(--space-2);
  }

  .prose :global(h2) {
    margin-top: var(--space-5);
    font-size: var(--step-2);
  }

  .prose :global(h2 + *) {
    margin-top: var(--space-2);
  }

  .prose :global(:is(ul, ol)) {
    padding-left: var(--space-3);
  }

  .prose :global(li + li) {
    margin-top: var(--space-1);
  }

  .prose :global(a) {
    color: var(--color-accent);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    border-radius: 4px;
    background: var(--color-surface);
  }

  .prose :global(pre) {
    padding: var(--space-2);
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .prose :global(:is(th, td)) {
    padding: var(--space-1) var(--space-1) var(--space-1) 0;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: 600;
  }

  .prose :global(.katex-display) {
    margin: var(--space-3) 0;
    padding: var(--space-1) 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .links {
    margin-top: var(--space-6);
  }

  /* A wide screen keeps the measure in the middle of the page and moves
     the facts and the contents into a column on its left, where they stay
     in view. Where the page is too narrow for a column on each side, the
     text moves right to make room. */
  @media (min-width: 64rem) {
    .article {
      display: grid;
      grid-template-columns:
        minmax(15rem, 1fr) minmax(0, var(--width-prose))
        minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    .article > :not(.aside) {
      grid-column: 2;
    }

    .aside {
      grid-column: 1;
      grid-row: 2 / span 2;
      align-self: start;
      justify-self: end;
      width: 15rem;
      position: sticky;
      top: var(--space-4);
      margin-top: var(--space-5);
    }

    .facts {
      flex-direction: column;
    }

    .project {
      flex-direction: column;
    }

    .toc {
      display: block;
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-line);
    }
  }
</style>
