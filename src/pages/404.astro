---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Base from '../layouts/Base.astro'

// GitHub Pages serves this one page for every missing path, so it speaks both languages.
---

<Base
  title="Page not found · Aaron Yang"
  description="This page does not exist."
  alternates={false}
>
  <div class="missing">
    <h1>Page not found</h1>
    <p lang="zh-CN">页面不存在</p>
    <ul>
      <li>
        <a href={getRelativeLocaleUrl('en')}>Home</a>
      </li>
      <li>
        <a href={getRelativeLocaleUrl('zh')} lang="zh-CN">
          首页
        </a>
      </li>
    </ul>
  </div>
</Base>

<style>
  .missing {
    padding-block: var(--space-6);
  }

  h1 {
    font-size: var(--step-4);
  }

  p {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--step-1);
  }

  ul {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }

  a:hover {
    color: var(--color-text);
  }
</style>
