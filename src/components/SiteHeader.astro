---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { LANG_TAG, otherLang, pagePath, t, type Lang } from '../lib/i18n'

interface Props {
  lang: Lang
  /** False on a page with no counterpart in the other language. */
  alternates: boolean
}

const { lang, alternates } = Astro.props
const other = otherLang(lang)
const path = pagePath(Astro.url.pathname)
const home = getRelativeLocaleUrl(lang)
---

<header class="header">
  <nav class="nav wrap">
    <a
      class="name"
      href={home}
      aria-current={path === '' && alternates ? 'page' : undefined}
    >
      Aaron Yang
    </a>
    <ul class="links">
      <li>
        <a
          href={`${home}#projects`}
          aria-current={path.startsWith('projects/') ? 'true' : undefined}
        >
          {t(lang, 'projects')}
        </a>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(lang, 'articles/')}
          aria-current={
            path === 'articles/'
              ? 'page'
              : path.startsWith('articles/')
                ? 'true'
                : undefined
          }
        >
          {t(lang, 'articles')}
        </a>
      </li>
      {alternates && (
        <li>
          <a
            href={getRelativeLocaleUrl(other, path)}
            hreflang={LANG_TAG[other]}
            lang={LANG_TAG[other]}
          >
            {t(lang, 'language')}
          </a>
        </li>
      )}
    </ul>
  </nav>
</header>

<style>
  /* Where the name and the links do not fit on one line, the links move to
     a second line instead of breaking inside a name or a label. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    min-height: var(--space-6);
    padding-block: var(--space-2);
  }

  .name {
    font-weight: 600;
    text-decoration: none;
  }

  .name,
  .links a {
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .links a:hover,
  .links a[aria-current] {
    color: var(--color-text);
  }
</style>
