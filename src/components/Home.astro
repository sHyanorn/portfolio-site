---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { t, toLang } from '../lib/i18n'
import ProjectCard from './ProjectCard.astro'

const lang = toLang(Astro.currentLocale)
const projects = await getCollection('projects')
---

<Base title="Aaron Yang" description={t(lang, 'description')}>
  <section class="intro">
    <h1 class="rise">Aaron Yang</h1>
  </section>

  <section
    id="projects"
    class="rise"
    style="--rise: 1"
    aria-labelledby="projects-title"
  >
    <h2 id="projects-title">{t(lang, 'projects')}</h2>
    <div class="list">
      {projects.map((project) => (
        <ProjectCard {project} {lang} />
      ))}
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: var(--space-6) var(--space-7);
  }

  h1 {
    font-size: var(--step-5);
    line-height: 1.1;
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }
</style>
